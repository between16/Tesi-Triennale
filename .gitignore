TRM/9x9_go/go_raw_dataset/go9_filtered/
TRM/19x19_go/go_raw_dataset/19x19_professional_games/

# Generated datasets (compressed archives or memory-mapped split directories).
TRM/9x9_go/go_dataset_go9/
TRM/9x9_go/go_dataset/
TRM/9x9_go/go_raw_dataset/9x9_games/
TRM/19x19_go/go_dataset_professional_10k/
TRM/19x19_go/go_dataset_full/
TRM/19x19_go/go_dataset/

